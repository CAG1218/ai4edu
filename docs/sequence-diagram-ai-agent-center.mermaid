%% AI 智能体中心 - 时序图
%% 文件: docs/sequence-diagram.mermaid
%% 描述: 用户提问 → AI 回答生成 全链路时序图

sequenceDiagram
    participant FE as Frontend<br/>(AgentChatView)
    participant API as API Router<br/>(agents.py)
    participant IR as IntentRouter
    participant RCB as ResourceContextBuilder
    participant DB as Database<br/>(PostgreSQL)
    participant GS as GraphService<br/>(Neo4j)
    participant Agent as Agent<br/>(RAGAgent/SubjectAgent)
    participant LR as LLMRouter
    participant LLM as LLM Provider<br/>(DeepSeek/Qwen/Hunyuan)

    Note over FE,LLM: 用户提问 → AI 回答生成 全链路

    %% 1. 用户发送消息
    FE->>API: POST /agents/sessions/{id}/messages<br/>{content: "老师，导数那道题怎么做？", content_type: "text"}

    %% 2. 查询会话
    API->>DB: SELECT AgentSession WHERE id=:id AND user_id=:current_user.id
    DB-->>API: session {scene_type: "review", course_id: 42, agent_type: "subject"}

    %% 3. 保存用户消息
    API->>DB: INSERT AgentMessage (role="user", content="...")
    DB-->>API: user_msg.id = 201

    %% 4. 意图路由
    API->>IR: route("导数那道题怎么做？", context={scene_type: "review", current_agent_type: "subject"})
    Note over IR: 场景上下文暗示 → 沿用 current_agent_type
    IR-->>API: IntentType.SUBJECT → agent_type = "subject"

    %% 5. 获取 Agent 实例
    API->>API: _get_agent_instance("subject") → SubjectAgent()

    %% 6. 构建资源上下文（核心！）
    API->>RCB: build(db, user_id, tenant_id, course_id=42, query="导数...", scene_type="review")

    par 并行检索 4 类资源
        Note over RCB,DB: 1. 检索用户笔记
        RCB->>DB: SELECT Note WHERE owner_id=:user_id AND course_id=42 AND is_deleted=False<br/>ORDER BY updated_at DESC LIMIT 5
        DB-->>RCB: notes[] (3条)
    and
        Note over RCB,DB: 2. 检索课程资源
        RCB->>DB: SELECT Resource WHERE course_id=42 AND is_active=True LIMIT 5
        DB-->>RCB: resources[] (2条)
    and
        Note over RCB,GS: 3. 检索知识图谱
        RCB->>GS: search_nodes("导数", limit=3)
        GS-->>RCB: graph_nodes[] (1条: 导数的几何意义)
    and
        Note over RCB,DB: 4. 检索老师方法
        RCB->>DB: SELECT TeacherMethod WHERE course_id=42 AND is_active=True LIMIT 3
        DB-->>RCB: teacher_methods[] (1条: 导数定义法解题步骤)
    end

    RCB->>RCB: 组装 context_text<br/>【老师方法】导数定义法解题步骤...<br/>【我的笔记】导数基础概念...<br/>【课程资源】高二数学教材...<br/>【知识图谱】导数的几何意义...
    RCB->>RCB: 构建 citations[] + summary{}
    RCB-->>API: ContextResult {context_text, citations[3], summary{notes:3, resources:2, graph:1, methods:1}}

    %% 7. 调用 Agent
    API->>Agent: execute(messages, context={..., db, resource_context: context_text})

    Agent->>Agent: _build_messages()<br/>system_prompt + resource_context + 历史消息 + 用户问题

    %% 8. LLM 调用与 fallback
    Agent->>LR: call_llm(full_messages, scene_type="review")

    LR->>LR: get_model(scene_type="review")<br/>→ 场景偏好 deepseek → 检查优先级链 [deepseek, qwen, hunyuan]
    LR->>LR: _should_skip(deepseek)? → No (configured + available)

    LR->>LLM: POST {deepseek_base}/chat/completions<br/>{model: "deepseek-chat", messages, temperature: 0.7}

    alt 调用成功
        LLM-->>LR: 200 OK {choices[0].message.content, usage}
        LR->>LR: _record_success(deepseek)
        LR-->>Agent: {content: "这道题用定义法...", model: "deepseek-chat", usage, fallback_info: null}
    else 连续失败 < 2 次（重试）
        LLM--x LR: 429 Rate Limited
        LR->>LR: _record_failure(deepseek, "rate_limit")<br/>failure_count=1 < max_failures=2
        LR->>LR: 重试 deepseek
        LR->>LLM: POST /chat/completions (retry)
        LLM--x LR: 500 Server Error
        LR->>LR: _record_failure(deepseek, "server_error")<br/>failure_count=2 >= max_failures=2
        LR->>LR: 标记 deepseek.is_available = False<br/>切换到下一个 Provider: qwen
        LR->>LR: _should_skip(qwen)? → No
        LR->>LLM: POST {qwen_base}/chat/completions<br/>{model: "qwen-plus", messages}
        LLM-->>LR: 200 OK {content, usage}
        LR->>LR: _record_success(qwen)
        LR-->>Agent: {content: "...", model: "qwen-plus", usage,<br/>fallback_info: {from: "deepseek", to: "qwen", reason: "rate_limit"}}
    else 所有 Provider 不可用
        LR-->>Agent: 降级 → {content: "", model: "demo-rule-engine", degraded: True}
        Agent->>Agent: _demo_reply(messages) → 规则引擎回复
    end

    Agent-->>API: {content: "这道题用我们上课讲的定义法来解...", model: "deepseek-chat",<br/>citations: [...], context_summary: {...}, fallback_info: null}

    %% 9. 保存 AI 消息
    API->>DB: INSERT AgentMessage<br/>(role="assistant", content="...", model_name="deepseek-chat",<br/>metadata_json={"citations": [...], "context_summary": {...}, "model_fallback": false})
    DB-->>API: ai_msg.id = 202

    API->>DB: UPDATE AgentSession<br/>SET message_count += 2, last_message_at = NOW(), total_tokens += usage.total_tokens
    DB-->>API: OK

    %% 10. 返回响应
    API-->>FE: {code: 0, data: {<br/>  user_message: {id: 201, role: "user", content: "..."},<br/>  assistant_message: {id: 202, role: "assistant", content: "...", model_name: "deepseek-chat"},<br/>  citations: [{type: "teacher_method", title: "导数定义法解题步骤", source_url: "/resources/55", teacher_name: "陈老师"}, ...],<br/>  context_summary: {notes_count: 3, resources_count: 2, graph_nodes_count: 1, teacher_methods_count: 1},<br/>  model_used: "deepseek-chat",<br/>  model_fallback: false<br/>}}

    %% 11. 前端渲染
    FE->>FE: 渲染消息气泡 (marked → HTML)
    FE->>FE: 渲染 CitationList 组件<br/>(3条引用: 老师方法📝 / 笔记📝 / 图谱节点🕸)
    FE->>FE: 渲染 ContextBadges 组件<br/>(📎笔记(3) 📄资源(2) 🕸图谱(1) 👨‍🏫方法(1))
    Note over FE: 用户可点击引用跳转到对应资源详情页
